# JABARI configuration example
# Copy to ~/.config/qyvora-jabari/config.yaml (or ~/.qyvora-jabari/config.yaml)
# and edit. Values here match the keys loaded by internal/config; any key the
# framework does not read is ignored.

# Pipeline profile: quick | standard | deep | application | device |
# network | compliance | research
profile: standard

# Default output format: terminal (alias: table, text) | json | yaml
output: terminal

# Logging: level is debug | info | warn | error
log:
  level: info

# Mark runs as pre-authorized. Strong statement: only enable in environments
# you control and trust. Equivalent to passing -y on every command.
authorized: false

# Flags: equivalents of the --verbose / --quiet / --json CLI flags.
verbose: false
quiet: false
json: false

# Reporting: directory reports are written to, and the default format used by
# `assess --report` / `report` when no --format flag is given.
report:
  dir: reports
  format: terminal   # terminal | json | markdown | html
